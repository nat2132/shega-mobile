{
    "extends":  "./tsconfig.json",
    "compilerOptions":  {
                            "noEmit":  true,
                            "skipLibCheck":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "esModuleInterop":  true,
                            "moduleResolution":  "bundler",
                            "module":  "esnext",
                            "target":  "esnext",
                            "lib":  [
                                        "esnext",
                                        "dom"
                                    ],
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "src/*"
                                                  ]
                                      },
                            "ignoreDeprecations":  "6.0"
                        },
    "include":  [
                    "src/services/wsSyncClient.ts",
                    "src/screens/settings/settings.tsx",
                    "src/screens/settings/devices/PosHubScreen.tsx",
                    "src/types/*.d.ts",
                    "expo-env.d.ts"
                ]
}
