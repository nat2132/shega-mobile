{
  "expo": {
    "name": "Shega",
    "slug": "Shega",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo.png",
    "scheme": "shega",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
        "versionCode": 2,
        "adaptiveIcon": {
          "backgroundColor": "#E6F4FE",
          "foregroundImage": "./src/assets/images/logo.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nat1.Shega"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      "expo-secure-store",
      "expo-video",
      "expo-audio",
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c2ed669-c717-450f-a697-692503f950de"
      },
      "update": {
        "githubOwner": "nat2132",
        "githubRepo": "shega-mobile",
        "includePrereleases": false,
        "githubToken": "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"
      }
    }
  }
}
